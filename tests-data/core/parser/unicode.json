{
  "version": "1.0",
  "description": "Non-ASCII (Unicode) parser cases. Regression coverage for byte-vs-codepoint offset handling: quoted keys, quoted values, escaped quotes, and bool operators following multi-byte text must parse identically across languages. Includes astral (non-BMP / surrogate-pair) and CJK characters so Go (rune), Python (code point), and JS (UTF-16) all agree on the parsed value.",
  "test_suite": "unicode",
  "tests": [
    {
      "name": "like_cyrillic_value_and_clause",
      "input": "Body like 'киррилица' and Body='тело'",
      "expected_result": "success",
      "expected_ast": {
        "bool_operator": "and",
        "negated": false,
        "expression": null,
        "left": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "Body",
            "operator": "like",
            "value": "киррилица",
            "value_type": "string"
          },
          "left": null,
          "right": null
        },
        "right": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "Body",
            "operator": "=",
            "value": "тело",
            "value_type": "string"
          },
          "left": null,
          "right": null
        }
      }
    },
    {
      "name": "eq_cyrillic_value_and_clause",
      "input": "Body='катастрофа' and x=1",
      "expected_result": "success",
      "expected_ast": {
        "bool_operator": "and",
        "negated": false,
        "expression": null,
        "left": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "Body",
            "operator": "=",
            "value": "катастрофа",
            "value_type": "string"
          },
          "left": null,
          "right": null
        },
        "right": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "x",
            "operator": "=",
            "value": 1,
            "value_type": "int"
          },
          "left": null,
          "right": null
        }
      }
    },
    {
      "name": "cyrillic_values_or",
      "input": "a='ы' or b='я'",
      "expected_result": "success",
      "expected_ast": {
        "bool_operator": "or",
        "negated": false,
        "expression": null,
        "left": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "a",
            "operator": "=",
            "value": "ы",
            "value_type": "string"
          },
          "left": null,
          "right": null
        },
        "right": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "b",
            "operator": "=",
            "value": "я",
            "value_type": "string"
          },
          "left": null,
          "right": null
        }
      }
    },
    {
      "name": "quoted_cyrillic_key_and_value",
      "input": "'имя'='значение'",
      "expected_result": "success",
      "expected_ast": {
        "bool_operator": "",
        "negated": false,
        "expression": {
          "key": "'имя'",
          "operator": "=",
          "value": "значение",
          "value_type": "string"
        },
        "left": null,
        "right": null
      }
    },
    {
      "name": "escaped_quote_after_cyrillic",
      "input": "Body='катастрофа\\'x'",
      "expected_result": "success",
      "expected_ast": {
        "bool_operator": "",
        "negated": false,
        "expression": {
          "key": "Body",
          "operator": "=",
          "value": "катастрофа'x",
          "value_type": "string"
        },
        "left": null,
        "right": null
      }
    },
    {
      "name": "mixed_ascii_cyrillic_three_clauses",
      "input": "level='ошибка' and code=500 or msg='готово'",
      "expected_result": "success",
      "expected_ast": {
        "bool_operator": "or",
        "negated": false,
        "expression": null,
        "left": {
          "bool_operator": "and",
          "negated": false,
          "expression": null,
          "left": {
            "bool_operator": "",
            "negated": false,
            "expression": {
              "key": "level",
              "operator": "=",
              "value": "ошибка",
              "value_type": "string"
            },
            "left": null,
            "right": null
          },
          "right": {
            "bool_operator": "",
            "negated": false,
            "expression": {
              "key": "code",
              "operator": "=",
              "value": 500,
              "value_type": "int"
            },
            "left": null,
            "right": null
          }
        },
        "right": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "msg",
            "operator": "=",
            "value": "готово",
            "value_type": "string"
          },
          "left": null,
          "right": null
        }
      }
    },
    {
      "name": "astral_emoji_value",
      "input": "message='😀'",
      "expected_result": "success",
      "expected_ast": {
        "bool_operator": "",
        "negated": false,
        "expression": {
          "key": "message",
          "operator": "=",
          "value": "😀",
          "value_type": "string"
        },
        "left": null,
        "right": null
      }
    },
    {
      "name": "astral_emoji_and_clause",
      "input": "a='😀' and b='🎉'",
      "expected_result": "success",
      "expected_ast": {
        "bool_operator": "and",
        "negated": false,
        "expression": null,
        "left": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "a",
            "operator": "=",
            "value": "😀",
            "value_type": "string"
          },
          "left": null,
          "right": null
        },
        "right": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "b",
            "operator": "=",
            "value": "🎉",
            "value_type": "string"
          },
          "left": null,
          "right": null
        }
      }
    },
    {
      "name": "cjk_value_and_number",
      "input": "level='错误' and code=500",
      "expected_result": "success",
      "expected_ast": {
        "bool_operator": "and",
        "negated": false,
        "expression": null,
        "left": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "level",
            "operator": "=",
            "value": "错误",
            "value_type": "string"
          },
          "left": null,
          "right": null
        },
        "right": {
          "bool_operator": "",
          "negated": false,
          "expression": {
            "key": "code",
            "operator": "=",
            "value": 500,
            "value_type": "int"
          },
          "left": null,
          "right": null
        }
      }
    }
  ]
}
