{
    "name": "flyql-react",
    "version": "1.0.2",
    "description": "React editor components for FlyQL query language",
    "type": "module",
    "main": "./src/index.js",
    "exports": {
        ".": {
            "import": "./src/index.js"
        },
        "./flyql.css": "./src/flyql.css"
    },
    "files": [
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.css",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": [
