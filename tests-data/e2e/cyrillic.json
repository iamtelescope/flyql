{
  "version": "1.0",
  "description": "Cross-language Cyrillic (non-ASCII) e2e cases. Verifies that Python, Go, and JS produce identical row IDs for the same FlyQL query over Cyrillic data — both via the in-memory matcher and via generated SQL run against a dedicated `flyql_cyrillic_test` table in ClickHouse, StarRocks, and PostgreSQL. Regression coverage for the byte-vs-codepoint offset bug in the Go parser. `databases: []` marks a matcher-only case: `cyrillic_regex` is matcher-only because regex flavor/anchoring differs across the three SQL engines. `cyrillic_escaped_quote` runs on all databases and exercises generator quote-escaping end-to-end (the PostgreSQL generator emits `E'...'` escape-string literals so a `'` in a value stays valid under standard_conforming_strings).",
  "rows": [
    { "id": 1, "message": "привет",     "name": "алиса", "env": "прод", "count": 10 },
    { "id": 2, "message": "мир",        "name": "борис", "env": "тест", "count": 20 },
    { "id": 3, "message": "привет мир", "name": "алиса", "env": "прод", "count": 30 },
    { "id": 4, "message": "hello",      "name": "alice", "env": "prod", "count": 40 },
    { "id": 5, "message": "ка'та",      "name": "влад",  "env": "прод", "count": 50 }
  ],
  "tests": [
    { "name": "cyrillic_equals",              "flyql": "message='привет'",                  "expected_ids": [1],          "databases": ["clickhouse", "postgresql", "starrocks"] },
    { "name": "cyrillic_not_equals",          "flyql": "message!='привет'",                 "expected_ids": [2, 3, 4, 5], "databases": ["clickhouse", "postgresql", "starrocks"] },
    { "name": "cyrillic_like_prefix",         "flyql": "message like 'привет%'",            "expected_ids": [1, 3],       "databases": ["clickhouse", "postgresql", "starrocks"] },
    { "name": "cyrillic_and",                 "flyql": "message='привет' and name='алиса'", "expected_ids": [1],          "databases": ["clickhouse", "postgresql", "starrocks"] },
    { "name": "cyrillic_or",                  "flyql": "name='борис' or name='алиса'",      "expected_ids": [1, 2, 3],    "databases": ["clickhouse", "postgresql", "starrocks"] },
    { "name": "cyrillic_value_and_number",    "flyql": "env='прод' and count>15",           "expected_ids": [3, 5],       "databases": ["clickhouse", "postgresql", "starrocks"] },
    { "name": "ascii_control_among_cyrillic", "flyql": "name='alice'",                      "expected_ids": [4],          "databases": ["clickhouse", "postgresql", "starrocks"] },
    { "name": "cyrillic_regex",               "flyql": "message~'привет'",                  "expected_ids": [1, 3],       "databases": [] },
    { "name": "cyrillic_escaped_quote",       "flyql": "message='ка\\'та'",                 "expected_ids": [5],          "databases": ["clickhouse", "postgresql", "starrocks"] }
  ]
}
